{
    "openapi": "3.0.3",
    "info": {
        "title": "Appointment Service",
        "version": "1.0.0"
    },
    "paths": {
        "/appointments": {
            "post": {
                "summary": "Crear agendamiento",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "insuredId": {
                                        "type": "string",
                                        "example": "00012"
                                    },
                                    "scheduleId": {
                                        "type": "integer",
                                        "example": 100
                                    },
                                    "countryISO": {
                                        "type": "string",
                                        "enum": [
                                            "PE",
                                            "CL"
                                        ],
                                        "example": "PE"
                                    }
                                },
                                "required": [
                                    "insuredId",
                                    "scheduleId",
                                    "countryISO"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Aceptado"
                    },
                    "400": {
                        "description": "Solicitud inválida"
                    }
                }
            }
        },
        "/appointments/{insuredId}": {
            "get": {
                "summary": "Listar agendamientos por asegurado",
                "parameters": [
                    {
                        "in": "path",
                        "name": "insuredId",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/openapi.json": {
            "get": {
                "summary": "Descargar OpenAPI JSON",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        }
    }
}
